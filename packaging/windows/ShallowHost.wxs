<?xml version="1.0" encoding="utf-8"?>

<!-- Built with WiX Toolset v6, WixToolset.UI.wixext, and WixToolset.Util.wixext. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="ShallowHost"
           Manufacturer="Noktomezo"
           Version="$(var.Version)"
           UpgradeCode="5DCDAC6E-FA85-4FED-80CD-E2A0220E4095"
           Language="1033"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of ShallowHost is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="ShallowHost">
          <Directory Id="ASSETSDIR" Name="assets" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="Application" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="ShallowHostExe"
              Name="ShallowHost.exe"
              Source="$(var.ExeFile)"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- WiX's Files harvesting keeps the directory tree below assets intact. -->
    <ComponentGroup Id="Assets" Directory="ASSETSDIR">
      <Files Include="$(var.AssetsDir)\**" />
    </ComponentGroup>

    <util:CloseApplication Id="CloseShallowHost"
                           Target="ShallowHost.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           Timeout="5"
                           TerminateProcess="0" />

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="ShallowHostShortcut"
                  Name="ShallowHost"
                  Target="[INSTALLFOLDER]ShallowHost.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU"
                       Key="Software\ShallowHost"
                       Name="Installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="Application" />
      <ComponentGroupRef Id="Assets" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Icon Id="ShallowHostIco" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="ShallowHostIco" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Noktomezo/ShallowHost" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch ShallowHost" />
    <Property Id="WixShellExecTarget" Value="[#ShallowHostExe]" />
    <CustomAction Id="LaunchShallowHost"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchShallowHost"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
